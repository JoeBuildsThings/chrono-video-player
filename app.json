{
  "expo": {
    "name": "Chrono Player",
    "slug": "chrono-video-player",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#040812"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Chrono Player requires media library access to organize and play your local videos."
      }
    },
    "android": {
      "backgroundColor": "#040812",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#040812"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_SETTINGS"
      ],
      "package": "com.joebuildsthings.chronoplayer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Chrono Player to access your media files.",
          "savePhotosPermission": "Allow Chrono Player to manage video metadata.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-screen-orientation"
    ]
  }
}
